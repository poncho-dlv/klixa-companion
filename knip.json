{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "tests/**/*.test.js",
    "desktop/renderer/renderer.js",
    "desktop/preload.cjs",
    "src/integrations/camskin/web/overlay.js",
    "src/integrations/camskin/web/tracker.js",
    "src/integrations/camskin/web/pose-worker.js"
  ],
  "ignoreUnresolved": ["/vendor/vision_bundle.mjs", "/vendor-three/three.module.js", "/vendor-three-addons/loaders/GLTFLoader.js"],
  "project": [
    "src/**/*.js",
    "desktop/**/*.js",
    "desktop/**/*.cjs",
    "tests/**/*.js"
  ],
  "rules": {
    "files": "error",
    "unresolved": "error",
    "dependencies": "error",
    "devDependencies": "error",
    "unlisted": "error",
    "exports": "warn",
    "types": "warn",
    "duplicates": "warn"
  }
  // exports/duplicates en warn (pas error) : primitives exportées comme surface d'API cohérente.
}
