{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "scripts/*.mjs",
    "tests/**/*.test.js",
    "desktop/renderer/renderer.js",
    "desktop/preload.cjs"
  ],
  "project": [
    "src/**/*.js",
    "desktop/**/*.js",
    "desktop/**/*.cjs",
    "scripts/**/*.mjs",
    "tests/**/*.js"
  ],
  "ignoreBinaries": ["where.exe"],
  "rules": {
    "files": "error",
    "unresolved": "error",
    "dependencies": "error",
    "devDependencies": "error",
    "unlisted": "error",
    "exports": "warn",
    "types": "warn",
    "duplicates": "warn"
  }
  // exports/duplicates en warn (pas error) : primitives exportées comme surface d'API cohérente.
}
