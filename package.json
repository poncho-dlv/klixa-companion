{
  "name": "klixa-companion",
  "version": "0.6.1",
  "description": "Agent local (hub) reliant les intégrations locales (machine à fumée, Hue, Streamer.bot, OBS, appareils LAN) au serveur Klixa cloud via une connexion sortante.",
  "author": "Klixa",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/poncho-dlv/klixa-companion.git"
  },
  "homepage": "https://github.com/poncho-dlv/klixa-companion#readme",
  "bugs": "https://github.com/poncho-dlv/klixa-companion/issues",
  "type": "module",
  "main": "desktop/main.js",
  "scripts": {
    "start": "node src/index.js",
    "desktop": "electron desktop/main.js",
    "dist:win": "electron-builder --win nsis --publish never",
    "test": "node --import ./tests/setup.mjs --test",
    "test:coverage": "c8 node --import ./tests/setup.mjs --test",
    "lint": "eslint .",
    "knip": "knip",
    "dup": "jscpd .",
    "prepare": "husky"
  },
  "dependencies": {
    "@streamerbot/client": "^1.12.2",
    "dotenv": "^16.4.5",
    "electron-updater": "^6.6.2",
    "obs-websocket-js": "^5.0.8",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "c8": "^12.0.0",
    "electron": "^39.8.5",
    "electron-builder": "^26.0.12",
    "eslint": "^10.8.0",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "eslint-plugin-sonarjs": "^4.2.0",
    "globals": "^17.8.0",
    "husky": "^9.1.7",
    "jscpd": "^5.0.14",
    "knip": "^6.31.0"
  },
  "build": {
    "appId": "live.klixa.companion",
    "productName": "Klixa Companion",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "src/**/*",
      "package.json"
    ],
    "asar": {
      "smartUnpack": false
    },
    "publish": {
      "provider": "github",
      "owner": "poncho-dlv",
      "repo": "klixa-companion"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Klixa-Companion-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
